{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // Lets node --test load the same modules the worker bundles. Only the files
    // a test imports need the explicit .ts extension.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*"]
}
