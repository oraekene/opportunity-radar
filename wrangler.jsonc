{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opportunity-radar",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "baadb8542499ad04ed9e0432215f3fb6",
  "triggers": {
    "crons": [
      "0 */8 * * *" // Runs 3 times daily (every 8 hours: 00:00, 08:00, 16:00 UTC) as a single cron trigger
    ]
  },
  "kv_namespaces": [
    {
      // 30-day seen set. Dedupe memory only, safe to wipe.
      "binding": "RADAR_SEEN",
      "id": "ee093d68ee2444cbabd920d56f76a609"
    },
    {
      // Daily history, dates index, settings, provider quota counters.
      "binding": "RADAR_HISTORY",
      "id": "f7f0f9c134f949089d74cdc19ebe9d0b"
    },
    {
      // What you acted on. Written only by POST /api/consumed.
      "binding": "RADAR_CONSUMED",
      "id": "1bac65346d0944959bae682f8ded0604"
    }
  ],
  "vars": {
    // Only non-secret values live here. Every key, token, phone and URL is set
    // with `wrangler secret put`, so a committed file never names a credential.
    "NOTIFIER_TARGET": "auto_router"
  }
}