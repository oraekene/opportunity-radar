{
  "name": "opportunity-radar-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker crawler for opportunities, grants, scholarships, competitions, freelance gigs, and jobs with WhatsApp alerts",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "calibrate": "esbuild tools/calibrate.ts --bundle --platform=node --format=esm --outfile=.calib.mjs --log-level=error && node .calib.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.7.3",
    "wrangler": "^4.147.0"
  }
}
